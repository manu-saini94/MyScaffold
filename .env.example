# Copy to .env and fill in. Never commit .env.

# --- Google OAuth (admin login + Photos Picker) ---
# Create in Google Cloud Console; see docs/google-photos-picker-notes.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control ---
# The only Google account allowed into /admin
ADMIN_EMAIL=you@example.com
# Long random string used to HMAC-sign the viewer cookie (e.g. `openssl rand -base64 48`)
VIEWER_COOKIE_SECRET=

# --- Storage ---
# Folder for the H2 database and cached photos. Must be a persistent volume in production.
OURSTORY_DATA_DIR=./data

# --- Viewer unlock (Phase 2B) ---
# Read ONCE at startup and stored hashed (PBKDF2) in the database; never commit real values.
# Question shown on the lock screen:
# OURSTORY_UNLOCK_QUESTION=
# Accepted answers, comma-separated (case, spaces and accents-compat forms are ignored when comparing):
# OURSTORY_UNLOCK_ANSWERS=
# Set true for ONE start to replace stored credentials from the two variables above (signs every viewer out):
# OURSTORY_UNLOCK_FORCE_RESET=false
